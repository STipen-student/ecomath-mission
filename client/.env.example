# ============================================================
#  Ecomath Mission - Contoh konfigurasi environment (CLIENT)
# ============================================================
#  Salin berkas ini menjadi ".env" (atau ".env.local").
#  Hanya variabel berawalan VITE_ yang terbaca oleh aplikasi.
#
#  PERINGATAN: nilai VITE_ ikut terbundel ke dalam berkas JavaScript
#  yang dapat dilihat siapa pun. JANGAN pernah menaruh ADMIN_API_KEY
#  atau kredensial apa pun di sini.
# ============================================================

# Alamat backend.
# Lokal   : http://localhost:4000
# Produksi: URL Railway, mis. https://ecomath-backend-production.up.railway.app
# Tanpa garis miring di akhir.
VITE_API_URL=http://localhost:4000
