# ============================================================
#  Ecomath Mission - Contoh konfigurasi environment (BACKEND)
# ============================================================
#  Salin berkas ini menjadi ".env" lalu isi nilainya.
#  JANGAN pernah meng-commit berkas .env yang berisi nilai asli.
#  Berkas .gitignore di root project sudah mengecualikan .env.
# ============================================================

# Mode aplikasi: development | test | production
NODE_ENV=development

# Port server backend
PORT=4000

# ------------------------------------------------------------
# Koneksi database
# ------------------------------------------------------------
# LOKAL (SQLite) - tidak perlu instalasi apa pun, cukup baris ini:
DATABASE_URL="file:./dev.db"
#
# PRODUKSI (PostgreSQL di Railway) - Railway menyediakan nilainya otomatis.
# Sebelum memakainya jalankan: npm run db:use-postgres
# Contoh bentuk nilainya (JANGAN pakai nilai contoh ini):
# DATABASE_URL="postgresql://pengguna:katasandi@host:5432/namadatabase"

# ------------------------------------------------------------
# Kunci akses endpoint admin (guru/peneliti)
# ------------------------------------------------------------
# Minimal 16 karakter. Buat nilai acak, JANGAN pakai contoh di bawah apa adanya.
# Cara membuat nilai acak:
#   Windows PowerShell : [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))
#   macOS / Linux      : openssl rand -base64 24
ADMIN_API_KEY=ganti-dengan-kunci-acak-minimal-16-karakter

# ------------------------------------------------------------
# CORS - alamat front-end yang diizinkan mengakses backend
# ------------------------------------------------------------
# Pisahkan beberapa alamat dengan koma, TANPA garis miring di akhir.
# WAJIB diisi saat NODE_ENV=production; server menolak start bila kosong.
# Di development, http://localhost:5173 sudah diizinkan otomatis.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# Mode pemilihan soal (Activity Selection) - lihat docs/SCORING_SPEC.md §7.16
# ------------------------------------------------------------
# true  = varian dalam SATU level dipilih menyesuaikan pita kemampuan siswa.
#         Keempat level tetap wajib bagi semua siswa; adaptivitas tidak pernah
#         melewati level maupun mengubah bukti yang tersedia.
# false = fixed-form (acak berstrata). Skor mentah antar siswa sebanding tanpa
#         perlu kalibrasi IRT.
#
# SETEL false SAAT PENGAMBILAN DATA SKRIPSI selama butir belum dikalibrasi
# (Rasch/IRT). Nilai ini hanya menetapkan keadaan AWAL - guru dapat mengubahnya
# saat berjalan lewat portal guru untuk demonstrasi, dan keadaan kembali ke
# nilai ini setiap kali server dijalankan ulang.
ADAPTIVE_MODE=true

# ------------------------------------------------------------
# Pembatasan laju permintaan (dihitung per sesi siswa, bukan per alamat IP,
# supaya satu kelas di balik satu jaringan sekolah tidak saling memblokir)
# ------------------------------------------------------------
RATE_LIMIT_SUBMIT_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_MAX=20
RATE_LIMIT_LOG_WINDOW_MS=60000
RATE_LIMIT_LOG_MAX=600
